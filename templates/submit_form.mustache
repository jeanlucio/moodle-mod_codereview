{{!
    @template mod_codereview/submit_form

    The student's submission form, with the notices that must be read before sending.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="codereview-submit"

    Context variables required for this template:
    * cmid int The course module id
    * formhtml string The rendered submission form
    * integritychecks bool Whether authorship verification is on

    Example context (json):
    {
        "cmid": 7,
        "formhtml": "<form></form>",
        "integritychecks": true,
        "isresubmission": false
    }
}}
<div class="cr-submit" data-region="codereview-submit" data-cmid="{{cmid}}">

    <div class="cr-notice cr-notice-info">
        <i class="fa fa-globe" aria-hidden="true"></i>
        {{#str}} publicrepowarning, mod_codereview {{/str}}
    </div>

    {{#integritychecks}}
        <div class="cr-notice cr-notice-info">
            <i class="fa fa-shield" aria-hidden="true"></i>
            {{#str}} authorshipnotice, mod_codereview {{/str}}
        </div>
    {{/integritychecks}}

    {{#isresubmission}}
        <div class="cr-notice cr-notice-warning">
            <i class="fa fa-refresh" aria-hidden="true"></i>
            {{#str}} resubmissionnotice, mod_codereview {{/str}}
        </div>
    {{/isresubmission}}

    <div data-region="codereview-submit-errors" role="alert" aria-live="polite"></div>

    {{{formhtml}}}
</div>
