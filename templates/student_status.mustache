{{!
    @template mod_codereview/student_status

    The student's own submission: where it points and when it was sent. What the automated
    checks and the AI review made of it is for the teacher, so none of it is shown here.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * cmid int The course module id
    * hassubmission bool Whether the student has submitted
    * repourl string Link to the repository on GitHub
    * commitsha string The submitted commit
    * submitteddateformatted string When it was sent
    * islate bool Whether it was sent after the due date
    * isgraded bool Whether the teacher has already approved a grade

    Example context (json):
    {
        "cmid": 7,
        "hassubmission": true,
        "repourl": "https://github.com/octocat/hello-world",
        "commitsha": "1234567890abcdef1234567890abcdef12345678",
        "submitteddateformatted": "20 July 2026, 10:15 AM",
        "islate": false,
        "isgraded": false
    }
}}
<div class="cr-status" data-cmid="{{cmid}}">
    {{#hassubmission}}
        <div class="cr-panel">
            <h3>{{#str}} submissiondetails, mod_codereview {{/str}}</h3>

            <dl class="cr-details">
                <dt>{{#str}} repourl, mod_codereview {{/str}}</dt>
                <dd>
                    <a href="{{repourl}}" rel="noopener" target="_blank"
                       aria-label="{{#str}} opensinnewtab, mod_codereview {{/str}}">{{repourl}}</a>
                </dd>
                <dt>{{#str}} commitsha, mod_codereview {{/str}}</dt>
                <dd><code>{{commitsha}}</code></dd>
                <dt>{{#str}} submittedon, mod_codereview {{/str}}</dt>
                <dd>{{submitteddateformatted}}</dd>
            </dl>

            {{#islate}}
                <p class="cr-alert cr-alert-warning">
                    <i class="fa fa-clock-o" aria-hidden="true"></i>
                    {{#str}} islate, mod_codereview {{/str}}
                </p>
            {{/islate}}

            {{^isgraded}}
                <p>{{#str}} studentgradenotice, mod_codereview {{/str}}</p>
            {{/isgraded}}
        </div>
    {{/hassubmission}}
</div>
